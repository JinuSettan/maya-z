# Copy to .env locally; never commit real secrets.
# Generate a long random value locally before setting this.
TESSA_PAIRING_TOKEN=
PORT=8990
# Local-only default. For LAN access, explicitly set HOST to the trusted interface.
HOST=127.0.0.1
# Optional dedicated workspace directory.
TESSA_WORKSPACE=./workspace
# Supabase server-side credentials are intentionally not included here.
# Add them only in your hosting provider's secret manager when the API is implemented.
